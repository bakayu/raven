  "db_name": "SQLite",
  "query": "\n        SELECT\n            a.id as \"id!\",\n            a.token_id,\n            a.hostname,\n            a.ip,\n            a.os as \"os!\",\n            a.agent_version as \"agent_version!\",\n            a.log_files,\n            a.first_seen_at,\n            a.last_seen_at\n        FROM agents a\n        INNER JOIN agent_tokens t ON a.token_id = t.id\n        WHERE t.created_by = ?\n        ORDER BY a.first_seen_at DESC\n        ",
